# Blockchain Network URLs
MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
GOERLI_URL=https://goerli.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private Keys (NEVER commit real private keys!)
PRIVATE_KEY=your_private_key_here
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
INFURA_PROJECT_ID=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key

# Gas Reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Security Audit Tools
MYTHX_API_KEY=your_mythx_api_key
SLITHER_ARGS=--sarif-input audits/slither/slither.sarif

# API Configuration
API_PORT=3001
API_HOST=localhost
DATABASE_URL=mongodb://localhost:27017/defi-vault
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000

# Web Configuration
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_API_URL=http://localhost:3001