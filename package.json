{
  "name": "modular-defi-vault-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Upgradeable DeFi Vault & Marketplace with ERC-4626 + ERC-1155",
  "keywords": [
    "defi",
    "vault",
    "erc4626",
    "erc1155",
    "upgradeable",
    "marketplace"
  ],
  "author": "Your Name",
  "license": "MIT",
  "workspaces": [],
  "scripts": {
    "install:all": "yarn install",
    "build": "yarn build:contracts",
    "build:contracts": "hardhat compile",
    "test": "yarn test:contracts",
    "test:contracts": "hardhat test",
    "test:unit": "hardhat test test/unit/**/*.test.ts",
    "test:integration": "hardhat test test/integration/**/*.test.ts",
    "test:fuzz": "yarn echidna:run",
    "test:coverage": "hardhat coverage",
    "lint": "yarn lint:contracts",
    "lint:contracts": "solhint 'contracts/**/*.sol'",
    "lint:fix": "yarn lint:contracts --fix",
    "format": "prettier --write .",
    "audit:slither": "slither . --sarif-input audits/slither/slither.sarif",
    "audit:echidna": "echidna audits/echidna/echidna.yaml",
    "audit:mythx": "mythx analyze contracts/ --output audits/mythx/mythx-report.json",
    "deploy:local": "hardhat run scripts/deploy/deploy-local.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy/deploy-testnet.ts --network goerli",
    "deploy:mainnet": "hardhat run scripts/deploy/deploy-mainnet.ts --network mainnet",
    "verify": "hardhat run scripts/verify/verify-contracts.ts",
    "upgrade": "hardhat run scripts/upgrade/upgrade-contracts.ts",
    "dev": "hardhat node",
    "typechain": "hardhat typechain"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.2.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "ethers": "^6.4.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.1",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0",
    "axios": "^1.12.2"
  }
}
